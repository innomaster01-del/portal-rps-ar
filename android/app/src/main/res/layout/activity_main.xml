<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="#000000">

    <android.opengl.GLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/debugView"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="90dp"
        android:adjustViewBounds="true"
        android:background="#66000000"
        android:contentDescription="מה המצלמה מזהה"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/netChip" style="@style/Chip" android:text="לא מחובר" />
            <TextView android:id="@+id/handChip" style="@style/Chip" android:visibility="gone" />
            <TextView android:id="@+id/scoreChip" style="@style/Chip" android:textColor="#4DFF9A" android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="26dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="26dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/bannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/bannerSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#A9BDB2"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="#A9BDB2"
                    android:textSize="14.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/lobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="אבן נייר ומספריים דרך פורטל 🌀"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="כל אחד מציב פורטל על השולחן ומכניס אליו יד. היד שלך יוצאת מהפורטל של היריב, והטלפון קובע מי ניצח."
                        android:textColor="#A9BDB2"
                        android:textSize="14.5sp" />

                    <Button
                        android:id="@+id/soloBtn"
                        style="@style/Btn.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="0dp"
                        android:text="🤖 שחק נגד המחשב" />

                    <Button
                        android:id="@+id/createBtn"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="0dp"
                        android:text="👥 צור חדר עם חבר" />

                    <LinearLayout
                        android:id="@+id/roomInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_code"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="קוד החדר"
                            android:textColor="#A9BDB2" />

                        <TextView
                            android:id="@+id/roomCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.3"
                            android:textColor="#4DFF9A"
                            android:textDirection="ltr"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/shareBtn"
                            style="@style/Btn"
                            android:layout_marginTop="6dp"
                            android:text="שלח לחבר" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="או"
                        android:textColor="#A9BDB2"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/codeIn"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:hint="קוד"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:letterSpacing="0.3"
                            android:maxLength="4"
                            android:textColor="#EEF7F1"
                            android:textColorHint="#667A70"
                            android:textDirection="ltr"
                            android:textSize="20sp" />

                        <Button
                            android:id="@+id/joinBtn"
                            style="@style/Btn"
                            android:text="הצטרף" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/debugChk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:buttonTint="#4DFF9A"
                        android:text="הצג מה המצלמה מזהה"
                        android:textColor="#A9BDB2" />

                    <CheckBox
                        android:id="@+id/manualChk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#4DFF9A"
                        android:text="שחק עם כפתורים במקום זיהוי יד"
                        android:textColor="#A9BDB2" />

                    <Button
                        android:id="@+id/closeLobbyBtn"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="0dp"
                        android:text="סגור" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/manualBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button android:id="@+id/mIn" style="@style/Btn" android:text="✋ הכנס יד" />
            <Button android:id="@+id/gRock" style="@style/Btn" android:text="🪨" android:contentDescription="אבן" />
            <Button android:id="@+id/gPaper" style="@style/Btn" android:text="📄" android:contentDescription="נייר" />
            <Button android:id="@+id/gScissors" style="@style/Btn" android:text="✂️" android:contentDescription="מספריים" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/moveBtn" style="@style/Btn" android:text="הזז פורטל" android:visibility="gone" />
            <Button android:id="@+id/openLobbyBtn" style="@style/Btn" android:text="⚙️ חדר" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
